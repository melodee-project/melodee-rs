  {
    "schemaVersion": 2,
    "name": "os-stream-range-middle",
    "surface": "opensubsonic",
    "method": "GET",
    "path": "/rest/stream.view?f=json&v=1.16.1&c=phase0&id=song_2b8eab4b-235d-5892-99f8-c0f5f54e8ab4&u=phase0-fixture&t={{env:PHASE0_SUBSONIC_TOKEN}}&s={{env:PHASE0_SUBSONIC_SALT}}",
    "auth": "none",
    "headers": {
      "X-Forwarded-For": "203.0.113.7",
      "X-Forwarded-Host": "capture-fixture.example.test",
      "Range": "bytes=100000-101023"
    },
    "normalize": {
      "maskJsonPaths": [
        "$.subsonic-response.serverVersion"
      ],
      "dropHeaders": [
        "etag",
        "last-modified"
      ]
    },
    "notes": "CRITICAL DISCOVERY (double range processing): the 206 path wraps the file in a BoundedStream but leaves ASP.NET EnableRangeProcessing=true, so the client's Range header is applied a SECOND time against the range-length stream. bytes=100000-101023 on a 220544-byte file -> 416 (Content-Range bytes */1024). Any nonzero-offset range is either 416 or silently mangled (see os-stream-range-middle-mangled). Only start=0 and suffix ranges work (accidentally). Native-surface streaming does this correctly (EnableRangeProcessing=false). MUST NOT be preserved — Rust deviation requires product sign-off.",
    "expectStatus": 416
  },
