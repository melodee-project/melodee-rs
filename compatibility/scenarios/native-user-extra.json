      {"name":"user-songs-recent","method":"GET","path":"/api/v1/user/songs/recently-played?page=1&limit=50","auth":"bearer-var:accessToken","allowFailure":true,"normalize":{"maskBaseUrl":true,"maskUrlAuthTokenPaths":["$.data[*].streamUrl"]}},
