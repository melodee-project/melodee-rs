  {
    "schemaVersion": 2,
    "name": "auth-user-expired-token",
    "surface": "melodee-api-v1",
    "method": "GET",
    "path": "/api/v1/user/me",
    "auth": "none",
    "headers": {
      "Authorization": "Bearer {{env:LEGACY_MELODEE_EXPIRED_JWT}}"
    },
    "expectStatus": 401,
    "normalize": {
      "maskJsonPaths": ["$.correlationId"]
    },
    "notes": "Expired but well-formed JWT signed with the committed fixture key (generate with scripts/gen_fixture_tokens.py; ValidateLifetime=true, ClockSkew=Zero in the oracle). Skipped if LEGACY_MELODEE_EXPIRED_JWT is unset."
  },
  {
