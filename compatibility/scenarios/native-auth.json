[
  {
    "schemaVersion": 2,
    "name": "auth-login-success",
    "surface": "melodee-api-v1",
    "method": "POST",
    "path": "/api/v1/auth/authenticate",
    "auth": "none",
    "json": {
      "userName": "phase0-fixture",
      "password": "Mel0deeR0cks!"
    },
    "allowFailure": false,
    "normalize": {
      "maskJsonPaths": ["$.token", "$.expiresAt", "$.refreshToken", "$.refreshTokenExpiresAt", "$.user.createdAt", "$.user.updatedAt", "$.serverVersion"],
      "maskBaseUrl": true,
      "structureChecks": {
        "$.token": "jwt",
        "$.refreshToken": "opaqueToken"
      }
    },
    "notes": "Fixture credentials are synthetic and public (scripts/legacy_oracle.py). Token VALUES are masked at capture time; their structure is validated and recorded in metadata instead. user.id is the deterministic fixture UUID and is deliberately NOT masked (public-ID stability evidence, PRD-API-M1-004)."
  },
  {
    "schemaVersion": 2,
