    "method": "POST",
    "path": "/api/v1/auth/refresh-token",
    "auth": "none",
    "json": {"refreshToken": "phase0-not-a-real-refresh-token", "deviceId": "phase0-fixture-device"},
    "expectStatus": 401,
    "normalize": {
