    "flow": [
      {
        "name": "login",
        "method": "POST",
        "path": "/api/v1/auth/authenticate",
        "auth": "none",
        "json": {
          "userName": "phase0-fixture",
          "password": "Mel0deeR0cks!"
        },
        "capture": {
          "accessToken": "$.token"
        },
        "secretCapture": [
          "accessToken"
        ],
        "normalize": {
          "maskJsonPaths": [
            "$.token",
            "$.expiresAt",
            "$.refreshToken",
            "$.refreshTokenExpiresAt",
            "$.user.createdAt",
            "$.user.updatedAt",
            "$.serverVersion"
