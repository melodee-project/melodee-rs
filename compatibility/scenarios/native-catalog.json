        "path": "/api/v1/albums/645680d3-704a-5b83-a734-42a3fa88c3ed",
        "auth": "bearer-var:accessToken",
        "normalize": {
          "maskBaseUrl": true
        },
        "notes": "Multi-disc Release: disc-qualified SongNumbers 101/102/201/202, PartTitles disc subtitles. The legacy schema has no disc column; (AlbumId,SongNumber) is unique."
      },
      {
        "name": "album-detail-minimal-metadata",
