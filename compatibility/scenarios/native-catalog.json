      },
      {
        "name": "scrobble-now-playing",
        "method": "POST",
        "path": "/api/v1/scrobble",
        "auth": "bearer-var:accessToken",
        "json": {
          "songId": "d493e627-df71-50ed-93fb-c29b9f6ec96a",
          "playerName": "MelodeePlayer",
          "scrobbleTypeValue": 1,
          "scrobbleType": "nowPlaying",
          "timestamp": 1786050000.0,
          "playedDuration": 10.0
        },
        "normalize": {},
        "notes": "Android ScrobbleManager body shape, including the redundant integer scrobbleTypeValue the client sends (server parses the string scrobbleType). Fixed synthetic timestamp for determinism."
      },
      {
        "name": "scrobble-played",
        "method": "POST",
        "path": "/api/v1/scrobble",
        "auth": "bearer-var:accessToken",
        "json": {
          "songId": "d493e627-df71-50ed-93fb-c29b9f6ec96a",
          "playerName": "MelodeePlayer",
          "scrobbleTypeValue": 2,
          "scrobbleType": "played",
          "timestamp": 1786050060.0,
          "playedDuration": 60.0
        },
        "normalize": {}
      },
      {
        "name": "song-detail-after-scrobble",
        "method": "GET",
        "path": "/api/v1/songs/d493e627-df71-50ed-93fb-c29b9f6ec96a",
        "auth": "bearer-var:accessToken",
        "normalize": {
          "maskBaseUrl": true,
          "maskUrlAuthTokenPaths": [
            "$.streamUrl"
          ],
          "maskJsonPaths": [
            "$.lastPlayedAt"
          ]
        },
        "notes": "Verifies the played scrobble incremented playedCount (diff against song-detail-before-scrobble)."
      },
      {
        "name": "scrobble-unknown-song",
        "method": "POST",
        "path": "/api/v1/scrobble",
        "auth": "bearer-var:accessToken",
        "json": {
          "songId": "00000000-0000-0000-0000-000000000000",
          "playerName": "MelodeePlayer",
          "scrobbleType": "played",
          "timestamp": 1786050060.0,
          "playedDuration": 60.0
        },
        "expectStatus": 500,
        "normalize": {
          "maskJsonPaths": [
            "$.correlationId"
          ]
        },
        "notes": "DISCOVERY: unknown songId returns HTTP 500 INTERNAL_ERROR, not the documented 400 'Unknown song' (the controller's ApiBadRequest path is unreachable because songService.GetByApiKeyAsync fails first — same root cause class as the artist/album/song/playlist detail 500s)."
      }
    ]
