        "path": "/api/v1/artists/813c11e0-61cd-5204-ae0f-ce68386eacec/songs?page=1&pageSize=50",
        "auth": "bearer-var:accessToken",
        "normalize": {
          "maskBaseUrl": true,
          "maskUrlAuthTokenPaths": [
            "$.data[*].streamUrl"
          ],
          "structureChecks": {
            "$.data[0].streamUrl": "streamAuthToken"
          }
        },
        "notes": "Android Auto artist-search path (MusicService.kt:717). Song payload embeds the self-authenticating streamUrl; the HMAC token segment is masked and structurally validated instead."
      },
      {
        "name": "albums-list",
        "method": "GET",
