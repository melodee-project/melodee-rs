          "structureChecks": {
            "$.token": "jwt"
          }
        }
      },
      {
        "name": "artists-list",
        "method": "GET",
        "path": "/api/v1/artists?page=1&pageSize=5&orderBy=Name&orderDirection=asc",
        "auth": "bearer-var:accessToken",
        "normalize": {
          "maskBaseUrl": true,
          "maskUrlAuthTokenPaths": [
            "$.data[*].streamUrl"
          ]
        },
        "notes": "Paged artist browse with the meta/data envelope the Android client deserializes."
      },
      {
        "name": "artists-list-page2",
        "method": "GET",
        "path": "/api/v1/artists?page=2&pageSize=5&orderBy=Name&orderDirection=asc",
        "auth": "bearer-var:accessToken",
        "normalize": {
          "maskBaseUrl": true
        },
        "notes": "Pagination continuation; meta.hasNext/hasPrevious behavior."
      },
      {
        "name": "artists-recent",
        "method": "GET",
        "path": "/api/v1/artists/recent?limit=4",
        "auth": "bearer-var:accessToken",
        "normalize": {
