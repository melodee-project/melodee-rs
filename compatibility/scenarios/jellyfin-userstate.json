[
  {
    "schemaVersion": 2,
    "name": "jf-userstate",
    "surface": "jellyfin",
    "flow": [
      {
        "name": "login",
        "method": "POST",
        "path": "/Users/AuthenticateByName",
        "json": {
          "Username": "phase0-fixture",
          "Pw": "Mel0deeR0cks!"
        },
        "capture": {
          "jfToken": "$.AccessToken"
        },
        "secretCapture": [
          "jfToken"
        ],
        "normalize": {
          "maskJsonPaths": [
            "$.AccessToken",
            "$.SessionInfo",
            "$.User.LastLoginDate",
            "$.User.LastActivityDate",
            "$.User.Configuration"
          ]
        }
      },
      {
        "name": "favorite-song",
        "method": "POST",
        "path": "/Users/f78448cc82ec5864877c6c6163b00065/FavoriteItems/c418d38313f5598d94a8c15e5d2df348",
        "auth": "none",
        "headers": {
          "Authorization": "MediaBrowser Client=\"Phase0Capture\", Device=\"Capture\", DeviceId=\"phase0-capture-1\", Version=\"1.0\", Token=\"{{jfToken}}\""
        },
        "normalize": {
          "maskJsonPaths": [
            "$.Key"
          ]
        },
        "notes": "POST favorite (star) a song; returns JellyfinUserItemData."
      },
      {
        "name": "verify-favorite",
        "method": "GET",
        "path": "/Items/c418d38313f5598d94a8c15e5d2df348?enableUserData=true",
        "auth": "none",
        "headers": {
          "Authorization": "MediaBrowser Client=\"Phase0Capture\", Device=\"Capture\", DeviceId=\"phase0-capture-1\", Version=\"1.0\", Token=\"{{jfToken}}\""
        },
        "normalize": {},
        "notes": "STATE VERIFICATION: UserData.IsFavorite true."
      },
      {
        "name": "unfavorite-song",
        "method": "DELETE",
        "path": "/Users/f78448cc82ec5864877c6c6163b00065/FavoriteItems/c418d38313f5598d94a8c15e5d2df348",
        "auth": "none",
        "headers": {
          "Authorization": "MediaBrowser Client=\"Phase0Capture\", Device=\"Capture\", DeviceId=\"phase0-capture-1\", Version=\"1.0\", Token=\"{{jfToken}}\""
        },
        "normalize": {
          "maskJsonPaths": [
            "$.Key"
          ]
        },
        "notes": "DELETE removes favorite."
      },
      {
        "name": "verify-unfavorite",
        "method": "GET",
        "path": "/Items/c418d38313f5598d94a8c15e5d2df348?enableUserData=true",
        "auth": "none",
        "headers": {
          "Authorization": "MediaBrowser Client=\"Phase0Capture\", Device=\"Capture\", DeviceId=\"phase0-capture-1\", Version=\"1.0\", Token=\"{{jfToken}}\""
        },
        "normalize": {},
        "notes": "IsFavorite false."
      },
      {
        "name": "played-album",
        "method": "POST",
        "path": "/Users/f78448cc82ec5864877c6c6163b00065/PlayedItems/69d9769974c55403878f87f42d9d9fbb",
        "auth": "none",
        "headers": {
          "Authorization": "MediaBrowser Client=\"Phase0Capture\", Device=\"Capture\", DeviceId=\"phase0-capture-1\", Version=\"1.0\", Token=\"{{jfToken}}\""
        },
        "normalize": {
          "maskJsonPaths": [
            "$.Key",
            "$.LastPlayedDate"
          ]
        },
        "notes": "POST played: increments PlayedCount (album)."
      },
      {
        "name": "unplayed-album",
        "method": "DELETE",
        "path": "/Users/f78448cc82ec5864877c6c6163b00065/PlayedItems/69d9769974c55403878f87f42d9d9fbb",
        "auth": "none",
        "headers": {
          "Authorization": "MediaBrowser Client=\"Phase0Capture\", Device=\"Capture\", DeviceId=\"phase0-capture-1\", Version=\"1.0\", Token=\"{{jfToken}}\""
        },
        "normalize": {
          "maskJsonPaths": [
            "$.Key"
          ]
        },
        "notes": "DELETE resets played state."
      },
      {
        "name": "favorite-unknown",
        "method": "POST",
        "path": "/Users/f78448cc82ec5864877c6c6163b00065/FavoriteItems/00000000000000000000000000000000",
        "auth": "none",
        "headers": {
          "Authorization": "MediaBrowser Client=\"Phase0Capture\", Device=\"Capture\", DeviceId=\"phase0-capture-1\", Version=\"1.0\", Token=\"{{jfToken}}\""
        },
        "normalize": {
          "maskJsonPaths": [
            "$.TraceId",
            "$.traceId"
          ]
        },
        "notes": "Unknown item -> 404.",
        "expectStatus": 404
      },
      {
        "name": "session-playing",
        "method": "POST",
        "path": "/Sessions/Playing",
        "auth": "none",
        "headers": {
          "Authorization": "MediaBrowser Client=\"Phase0Capture\", Device=\"Capture\", DeviceId=\"phase0-capture-1\", Version=\"1.0\", Token=\"{{jfToken}}\""
        },
        "normalize": {},
        "notes": "Playback start report -> 204; registers now-playing via ScrobbleService (PlaySessionId or 'Jellyfin' as client).",
        "json": {
          "ItemId": "2b8eab4b235d589299f8c0f5f54e8ab4",
          "PlaySessionId": "phase0-session-1",
          "PositionTicks": 0
        }
      },
      {
        "name": "session-progress",
        "method": "POST",
        "path": "/Sessions/Playing/Progress",
        "auth": "none",
        "headers": {
          "Authorization": "MediaBrowser Client=\"Phase0Capture\", Device=\"Capture\", DeviceId=\"phase0-capture-1\", Version=\"1.0\", Token=\"{{jfToken}}\""
        },
        "normalize": {},
        "notes": "204.",
        "json": {
          "ItemId": "2b8eab4b235d589299f8c0f5f54e8ab4",
          "PlaySessionId": "phase0-session-1",
          "PositionTicks": 300000000
        }
      },
      {
        "name": "sessions-list",
        "method": "GET",
        "path": "/Sessions",
        "auth": "none",
        "headers": {
          "Authorization": "MediaBrowser Client=\"Phase0Capture\", Device=\"Capture\", DeviceId=\"phase0-capture-1\", Version=\"1.0\", Token=\"{{jfToken}}\""
        },
        "normalize": {
          "maskJsonPaths": [
            "$[*].Id",
            "$[*].LastActivityDate",
            "$[*].NowPlayingItem.Etag",
            "$[*].PlayState"
          ]
        },
        "notes": "Synthesized from the scrobble now-playing cache: one session with NowPlayingItem, PlayMethod DirectPlay, CanSeek true. Volatile ids/timestamps masked."
      },
      {
        "name": "session-stopped",
        "method": "POST",
        "path": "/Sessions/Playing/Stopped",
        "auth": "none",
        "headers": {
          "Authorization": "MediaBrowser Client=\"Phase0Capture\", Device=\"Capture\", DeviceId=\"phase0-capture-1\", Version=\"1.0\", Token=\"{{jfToken}}\""
        },
        "normalize": {},
        "notes": "204; scrobbles unless Failed=true.",
        "json": {
          "ItemId": "2b8eab4b235d589299f8c0f5f54e8ab4",
          "PlaySessionId": "phase0-session-1",
          "PositionTicks": 600000000
        }
      },
      {
        "name": "sessions-list-after-stop",
        "method": "GET",
        "path": "/Sessions",
        "auth": "none",
        "headers": {
          "Authorization": "MediaBrowser Client=\"Phase0Capture\", Device=\"Capture\", DeviceId=\"phase0-capture-1\", Version=\"1.0\", Token=\"{{jfToken}}\""
        },
        "normalize": {
          "maskJsonPaths": [
            "$[*].Id",
            "$[*].LastActivityDate"
          ]
        },
        "notes": "Now-playing cleared after stop."
      },
      {
        "name": "session-playing-unknown-item",
        "method": "POST",
        "path": "/Sessions/Playing",
        "auth": "none",
        "headers": {
          "Authorization": "MediaBrowser Client=\"Phase0Capture\", Device=\"Capture\", DeviceId=\"phase0-capture-1\", Version=\"1.0\", Token=\"{{jfToken}}\""
        },
        "normalize": {},
        "notes": "Invalid ItemId -> 204 anyway (silently ignored).",
        "json": {
          "ItemId": "00000000000000000000000000000000",
          "PositionTicks": 0
        }
      },
      {
        "name": "session-ping",
        "method": "POST",
        "path": "/Sessions/Playing/Ping?playSessionId=phase0-session-1",
        "auth": "none",
        "headers": {
          "Authorization": "MediaBrowser Client=\"Phase0Capture\", Device=\"Capture\", DeviceId=\"phase0-capture-1\", Version=\"1.0\", Token=\"{{jfToken}}\""
        },
        "normalize": {},
        "notes": "204.",
        "expectStatus": 204
      },
      {
        "name": "capabilities-full",
        "method": "POST",
        "path": "/Sessions/Capabilities/Full",
        "auth": "none",
        "headers": {
          "Authorization": "MediaBrowser Client=\"Phase0Capture\", Device=\"Capture\", DeviceId=\"phase0-capture-1\", Version=\"1.0\", Token=\"{{jfToken}}\""
        },
        "normalize": {},
        "notes": "Acknowledge-only 204.",
        "expectStatus": 204,
        "json": {
          "PlayableMediaTypes": [
            "Audio"
          ],
          "SupportedCommands": [],
          "SupportsMediaControl": true
        }
      }
    ]
  }
]
