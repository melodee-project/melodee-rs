      {"name":"themes-import","method":"POST","path":"/api/v1/themes/import","auth":"bearer-var:accessToken","allowFailure":true,"normalize":{"maskBaseUrl":true,"maskJsonPaths":["$.correlationId"]}},
      {"name":"themes-export","method":"GET","path":"/api/v1/themes/phase7-missing/export","auth":"bearer-var:accessToken","allowFailure":true,"normalize":{"maskBaseUrl":true,"maskJsonPaths":["$.correlationId"]}},
      {"name":"themes-delete","method":"DELETE","path":"/api/v1/themes/phase7-missing","auth":"bearer-var:accessToken","allowFailure":true,"normalize":{"maskBaseUrl":true,"maskJsonPaths":["$.correlationId"]}},
      {"name":"themes-file","method":"GET","path":"/api/v1/themes/phase7-missing/file/theme.css","auth":"none","allowFailure":true,"normalize":{"maskBaseUrl":true,"maskJsonPaths":["$.correlationId"]}}
    ]
