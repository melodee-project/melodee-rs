[
  {
    "schemaVersion": 2,
    "name": "jf-root-no-markers",
    "surface": "jellyfin",
    "method": "GET",
    "path": "/",
    "auth": "none",
    "headers": {},
    "normalize": {
      "maskRegex": [
        {
          "pattern": "<!--Blazor:\\{.*?-->",
          "replace": "<!--Blazor:<volatile>-->"
        },
        {
          "pattern": "<!--Blazor-Server-Component-State:.*",
          "replace": "<!--Blazor-Server-Component-State:<volatile>-->"
        },
        {
          "pattern": "id=\"[A-Za-z0-9_-]{10}\"",
          "replace": "id=\"<volatile>\""
        }
      ],
      "dropHeaders": [
        "content-length",
        "etag",
        "last-modified"
      ]
    },
    "notes": "ROUTING: bare GET / with no Jellyfin markers is NOT rewritten — falls through to the Blazor app (text/html). Discovery probes must carry markers. (Body is the Blazor login page; Blazor prerender state is volatile and masked — the routing decision and content-type are the evidence.)"
  },
  {
    "schemaVersion": 2,
    "name": "jf-root-head-mediabrowser",
    "surface": "jellyfin",
    "method": "HEAD",
    "path": "/",
    "auth": "none",
    "headers": {
      "Authorization": "MediaBrowser Client=\"Phase0Capture\", Device=\"Capture\", DeviceId=\"phase0-capture-1\", Version=\"1.0\""
    },
    "normalize": {},
    "notes": "ROUTING: HEAD / with a MediaBrowser Authorization header IS rewritten to /api/jf -> 200 empty (RootController). Jellyfin client discovery probe."
  },
  {
    "schemaVersion": 2,
    "name": "jf-system-info-public",
    "surface": "jellyfin",
