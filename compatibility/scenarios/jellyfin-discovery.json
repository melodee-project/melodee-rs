    "auth": "none",
    "headers": {},
    "normalize": {
      "maskJsonPaths": [
        "$.Version",
        "$.LocalAddress",
        "$.Id"
      ]
    },
    "notes": "Allowlisted pre-auth route (rewritten regardless of headers). Id = MD5(Jwt:Issuer) — deterministic in the fixture environment. LocalAddress volatile per deployment; masked.",
    "notes_extra": null
  },
