{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melodee.org/schemas/compatibility-scenario-v1.json",
  "title": "Melodee compatibility capture scenario",
  "type": "object",
  "required": ["name", "method", "path", "auth"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "surface": { "enum": ["melodee-api-v1", "opensubsonic", "jellyfin"] },
    "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"] },
    "path": { "type": "string", "pattern": "^/" },
    "auth": { "enum": ["none", "bearer", "opensubsonic", "jellyfin-token"] },
    "headers": { "type": "object", "additionalProperties": { "type": "string" } },
    "json": {},
    "allowFailure": { "type": "boolean", "default": false },
    "normalize": {
      "type": "object",
      "description": "Volatile-field normalizers applied before comparison. Only values that legitimately vary between identical environments may be masked; never mask meaningful contract data.",
      "properties": {
        "maskJsonPaths": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\$(\\.[A-Za-z0-9_.-]+|\\[\\*\\]|\\[[0-9]+\\])*$" },
          "description": "JSON paths (subset: $.a.b, $.a[*].b, $.a[0].b) whose values are replaced with a placeholder before comparison."
        },
        "dropHeaders": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Response headers removed before comparison (e.g. volatile etags)."
        }
      },
      "additionalProperties": false
    },
    "expectedStatus": {
      "oneOf": [
        { "type": "integer", "minimum": 100, "maximum": 599 },
        { "type": "array", "items": { "type": "integer", "minimum": 100, "maximum": 599 } }
      ]
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
