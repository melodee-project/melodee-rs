# Local development only. Never commit real credentials.
MELODEE__SERVER__BIND=127.0.0.1:8080
RUST_LOG=melodee=debug,tower_http=info
MELODEE__DATABASE__URL=postgres://melodee:melodee-dev@127.0.0.1:5433/melodee

# Durable work claiming/retry bounds.
MELODEE__WORK__LEASE_SECONDS=300
MELODEE__WORK__RETRY_BASE_SECONDS=60
MELODEE__WORK__RETRY_MAX_SECONDS=3600
MELODEE__WORK__MAX_ATTEMPTS=5
MELODEE__WORK__CLAIM_BATCH_SIZE=4

# Inbound discovery. This external mailbox must be writable by the runtime
# user for rename/remove after a verified durable staging handoff. Inbound
# bytes are never rewritten.
MELODEE__INGEST__ENABLED=true
MELODEE__INGEST__SOURCE_ROOT=/absolute/path/to/inbound
# Durable Melodee-owned processing, review, and quarantine source storage.
# Required whenever inbound ingestion has a source root; never defaults to /tmp.
MELODEE__INGEST__STAGING_ROOT=/absolute/path/to/staging
# MELODEE__INGEST__SOURCE_LIBRARY_ID=019c0000-0000-7000-8000-000000000001
# MELODEE__INGEST__SOURCE_LIBRARY_NAME=local-inbound
# MELODEE__INGEST__SOURCES_JSON='[{"root":"/absolute/path/to/inbound","name":"local"}]'
MELODEE__INGEST__RECONCILIATION_INTERVAL_SECONDS=30
MELODEE__INGEST__SETTLING_QUIET_SECONDS=10
MELODEE__INGEST__READY_MARKER_NAME=.melodee-ready
MELODEE__INGEST__READY_MARKER_SHORTCUT_SECONDS=0

# Adjacent legacy C# server used during Phase 0 compatibility capture.
LEGACY_MELODEE_BASE_URL=http://127.0.0.1:5157
LEGACY_MELODEE_BEARER_TOKEN=

# Media inspection and normalization. Bare executable names use PATH.
MELODEE__INSPECTION__CONCURRENCY=2
MELODEE__INSPECTION__FFPROBE_PATH=ffprobe
MELODEE__INSPECTION__FFPROBE_TIMEOUT_SECONDS=30
MELODEE__NORMALIZATION__CONCURRENCY=2
MELODEE__NORMALIZATION__FFMPEG_PATH=ffmpeg
MELODEE__NORMALIZATION__FFMPEG_TIMEOUT_SECONDS=300
MELODEE__NORMALIZATION__FPCALC_PATH=fpcalc
MELODEE__NORMALIZATION__FPCALC_TIMEOUT_SECONDS=60
MELODEE__NORMALIZATION__WORK_AREA=/absolute/path/to/work

# Canonical long-term library. Keep it separate from inbound, staging, and work.
MELODEE__STORAGE__ROOT=/absolute/path/to/library
MELODEE__VALIDATION__CONCURRENCY=2
MELODEE__PUBLICATION__CONCURRENCY=2

# Manifest-v3 catalog import. This PostgreSQL-only worker is independent of
# inbound scanning and never rereads source or canonical media.
MELODEE__CATALOG__ENABLED=true
MELODEE__CATALOG__CONCURRENCY=2
MELODEE__CATALOG__BATCH_SIZE=16
MELODEE__CATALOG__POLL_INTERVAL_SECONDS=5

# Phase 5 classification, novelty, and policy evaluation. This PostgreSQL-only
# worker consumes catalog evidence and never opens source or canonical media.
MELODEE__POLICY__WORKER__ENABLED=true
MELODEE__POLICY__WORKER__POLL_INTERVAL_SECONDS=60
MELODEE__POLICY__CONCURRENCY=4
MELODEE__POLICY__BATCH_SIZE=500
# Increment this before changing any preference below; stored rule-set versions
# are immutable and startup fails on a same-version payload conflict.
MELODEE__POLICY__RULE_SET_VERSION=1
MELODEE__POLICY__DESTRUCTIVE_CONFIDENCE_BPS=8000
MELODEE__POLICY__REDUNDANT_GREATEST_HITS_DISPOSITION=ignore
MELODEE__POLICY__NOVEL_GREATEST_HITS_DISPOSITION=review
MELODEE__POLICY__UNCERTAIN_GREATEST_HITS_DISPOSITION=review

# Phase 6 rebuildable Tantivy projection. The root must be a dedicated absolute
# path and must not overlap inbound, normalization, or canonical storage roots.
MELODEE__SEARCH__ENABLED=false
# MELODEE__SEARCH__ROOT=/absolute/path/to/melodee-search
MELODEE__SEARCH__LEASE_SECONDS=60
MELODEE__SEARCH__BATCH_SIZE=256
MELODEE__SEARCH__MAX_OUTBOX_ATTEMPTS=5
MELODEE__SEARCH__POLL_INTERVAL_MS=1000
MELODEE__SEARCH__SNAPSHOT_PAGE_SIZE=1000
MELODEE__SEARCH__DEFAULT_LIMIT=200
MELODEE__SEARCH__MAX_LIMIT=1000

# Native Melodee API v1 podcast routes. Discovery uses bounded outbound HTTPS
# to the public iTunes Search API. The optional worker needs its own dedicated,
# non-overlapping storage root before it can refresh feeds or download episodes.
MELODEE__PODCAST__ENABLED=true
MELODEE__PODCAST__DISCOVERY_ENDPOINT=https://itunes.apple.com/
MELODEE__PODCAST__WORKER__ENABLED=false
# MELODEE__PODCAST__STORAGE_ROOT=/absolute/path/to/melodee-podcasts
MELODEE__PODCAST__WORKER__POLL_INTERVAL_SECONDS=30
MELODEE__PODCAST__WORKER__BATCH_SIZE=4
MELODEE__PODCAST__WORKER__LEASE_SECONDS=300
MELODEE__PODCAST__WORKER__MAX_ATTEMPTS=5
MELODEE__PODCAST__MAX_DOWNLOAD_BYTES=536870912

# Native-v1 public URLs, direct-stream capacity, and proxy trust boundary.
# PUBLIC_ORIGIN must be the externally reachable origin used by native clients.
# Absolute HTTP(S) origin only; credentials, paths, and queries are rejected.
MELODEE__NATIVE__PUBLIC_ORIGIN=http://127.0.0.1:8080
MELODEE__NATIVE__STREAM_CONCURRENCY=32
# Required: generate a unique value, for example with `openssl rand -base64 48`.
# The documented placeholder is rejected at startup.
MELODEE__NATIVE__AUTH__JWT_KEY=REPLACE_ME
MELODEE__NATIVE__AUTH__MAX_SESSION_DAYS=90
MELODEE__NATIVE__AUTH__DEVELOPMENT_RESET_TOKENS=false
MELODEE__NATIVE__AUTH__RATE_ATTEMPTS=10
MELODEE__NATIVE__AUTH__RATE_WINDOW_SECONDS=60
MELODEE__NATIVE__AUTH__RATE_MAX_KEYS=100000
# Comma-separated exact browser origins; no wildcard is accepted.
MELODEE__NATIVE__CORS__ALLOWED_ORIGINS=
# Comma-separated exact proxy IPs or CIDRs. Leave empty unless every listed
# address is controlled infrastructure. Forwarded chains are stripped from right to left.
MELODEE__NATIVE__TRUSTED_PROXIES=
# Google remains disabled unless all enabled settings validate. JWKS must use HTTPS.
MELODEE__NATIVE__AUTH__GOOGLE__ENABLED=false
MELODEE__NATIVE__AUTH__GOOGLE__CLIENT_ID=
MELODEE__NATIVE__AUTH__GOOGLE__JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
MELODEE__NATIVE__AUTH__GOOGLE__HOSTED_DOMAINS=

# Jellyfin-compatible access tokens are stateful and separately protected
# from native-v1 authentication. This is required whenever the server runs;
# generate a unique value of at least 32 bytes and keep it stable across
# server processes so existing Jellyfin sessions remain valid.
# The placeholder is intentionally rejected at startup.
MELODEE__JELLYFIN__TOKEN_PEPPER=REPLACE_ME
MELODEE__JELLYFIN__TOKEN_EXPIRES_AFTER_HOURS=168
