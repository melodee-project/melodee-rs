# Copy this file to .env next to compose.yml. Never commit the resulting .env.
# Use `openssl rand -base64 48` for each secret. Percent-encode reserved URL
# characters if you put them in MELODEE_DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-unique-password
MELODEE_DATABASE_URL=postgres://melodee:replace-with-a-long-unique-password@postgres:5432/melodee
MELODEE_NATIVE_JWT_KEY=replace-with-a-different-long-unique-secret
MELODEE_JELLYFIN_TOKEN_PEPPER=replace-with-another-long-unique-secret
MELODEE_NATIVE_PUBLIC_ORIGIN=https://music.example.com
# Exact origins used by the MeloAmp source UI and packaged desktop renderer.
MELODEE_NATIVE_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional browser OpenSubsonic client origins (for example https://feishin.vercel.app).
MELODEE_OPENSUBSONIC_CORS_ALLOWED_ORIGINS=
MELODEE_LOGGING_LEVEL=info
# Uncomment to append daily UTC log files to the persistent melodee_logs volume
# in addition to container stdout/stderr.
# MELODEE_LOGGING_DIRECTORY=/var/log/melodee

# Absolute host path containing inbound media. Melodee reads immutable bytes
# then renames/removes only successfully acquired candidate directories.
MELODEE_INBOUND_PATH=/srv/melodee/inbound

# Leave unset to expose only loopback and put TLS/reverse-proxy infrastructure
# in front of Melodee. Example direct binding: 0.0.0.0
# MELODEE_BIND_ADDRESS=127.0.0.1

# Stable deployments should pin a published X.Y.Z tag, not latest.
# For digest pinning, override the Compose service's full image reference with
# ghcr.io/melodee-project/melodee@sha256:<digest>; this variable accepts tags only.
MELODEE_IMAGE_TAG=latest

# Only exact addresses/CIDRs of reverse proxies you control. The address must be
# what the container sees, not necessarily the proxy's public or host address.
MELODEE_SERVER_TRUSTED_PROXIES=
# Unsafe compatibility escape hatch for isolated transition environments only.
MELODEE_OPENSUBSONIC_LEGACY_AUTH_BYPASS=false
